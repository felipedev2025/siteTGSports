# =============================================================================
# TG Sports — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores. NUNCA versione ".env".
# =============================================================================

# --- Banco de dados (PostgreSQL) --------------------------------------------
DATABASE_URL="postgresql://usuario:senha@localhost:5432/tgsports"
# Conexão DIRETA (sem pgbouncer/pooler), usada apenas pelo Prisma Migrate.
# Em desenvolvimento local, normalmente é a mesma URL de DATABASE_URL. Em
# provedores com pooler (ex.: Neon), use a variante "unpooled"/"direct" —
# ver README seção 7.1.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/tgsports"

# --- Autenticação ------------------------------------------------------------
# String aleatória forte (ex: `openssl rand -base64 48`). Usada para assinar
# os JWTs de sessão de admin e cliente. Trocar invalida todas as sessões.
AUTH_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# --- Asaas (pagamentos) -------------------------------------------------------
# Chave de API gerada em Asaas > Configurações > Integrações > Chaves de API.
# Comece SEMPRE pelo Sandbox (asaas.com/sandboxLogin) antes de ir para produção.
ASAAS_API_KEY="$aact_hmlg_sua_chave_sandbox_aqui"
ASAAS_ENV="sandbox"
# Opcional — só defina se precisar sobrescrever a URL base padrão do ambiente.
# ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"

# Token de autenticação do Webhook (Asaas > Integrações > Webhooks). Deve ser
# o MESMO valor configurado no cadastro do webhook no painel/API do Asaas.
ASAAS_WEBHOOK_TOKEN="gere-um-token-forte-de-32-a-255-caracteres"

# --- Aplicação -----------------------------------------------------------------
# URL pública da loja (usada para montar callbacks do Asaas Checkout).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret compartilhado para autenticar o cron de varredura de reservas
# expiradas (/api/cron/sweep). Na Vercel, defina uma env var chamada
# exatamente CRON_SECRET — o Vercel Cron usa esse mesmo nome automaticamente.
CRON_SECRET="gere-outro-token-forte"

# --- Armazenamento de arquivos -------------------------------------------------
# Diretório local onde as imagens de produto são salvas (host com disco
# persistente). Em produção, aponte para um volume persistente.
# STORAGE_DIR="/var/data/tgsports/uploads"

# Na Vercel, NÃO defina as duas variáveis acima — em vez disso, conecte um
# Blob Store ao projeto (Storage > Create Database > Blob). A Vercel injeta
# automaticamente BLOB_READ_WRITE_TOKEN, e o driver de storage troca sozinho
# para o Vercel Blob quando essa variável existir. Ver README seção 7.2.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
